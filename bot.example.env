# MarketAI Connector settings.
#
# 1. Copy this file to bot.env (bot.env is yours: never share or commit it).
# 2. Paste the two MarketAI lines from the My bots page.
# 3. Add your exchange's API keys below.
# 4. Start it:  docker compose up -d
#
# Everything else -- which signal feed, the leverage, pause and resume -- is set on the
# My bots page. The connector follows those changes by itself, without a restart.

# --- MarketAI: the two lines from My bots -------------------------------------------
MARKETAI_HOST=https://app.marketai.trade
MARKETAI_BOT_TOKEN=
# An older My bots page called the token MARKETAI_SLOT_TOKEN. That name still works.

# --- your exchange --------------------------------------------------------------------
# bitget or hyperliquid. The connector trades perpetual futures.
EXCHANGE=bitget
MARKETAI_MARKET_TYPE=futures

# Bitget: create an API key with TRADE permission only (never withdrawal).
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_MARGIN_MODE=crossed
BITGET_GRANULARITY=15m
# Practise first with no real money: use API keys from Bitget's demo account and set
# BITGET_DEMO=true

# Hyperliquid instead: set EXCHANGE=hyperliquid, delete the Bitget lines, and fill in:
# HYPERLIQUID_PRIVATE_KEY=       # an API wallet's key: it can trade but cannot withdraw
# HYPERLIQUID_ACCOUNT_ADDRESS=   # the account that API wallet trades for
# HYPERLIQUID_ENV=mainnet
# HYPERLIQUID_GRANULARITY=15m

# --- leverage ---------------------------------------------------------------------------
# Leave this out: the connector uses the leverage you set on My bots, and a change there
# applies to new entries (open positions keep their size). Setting it here overrides
# My bots.
# OPEN_LEVERAGE=

# --- one bot per exchange account ------------------------------------------------------
# Each entry is sized from the whole account's balance. Two bots on one account would
# each size as if the money were all theirs. Give every bot its own account or
# sub-account.

# --- this bot's name --------------------------------------------------------------------
# Names its log folder and its saved state. One name per bot.
NAME=MyMarketAIBot

# --- how orders are placed: keep these ----------------------------------------------------
# An entry rests as a maker order (the lower fee) for the first minute of the bar, then
# crosses the spread rather than miss it, and gives up at 90 seconds.
OPEN_TAKER_AFTER_SECONDS=60
OPEN_GIVE_UP_SECONDS=90
SIGNAL_BATCH_WINDOW_SECONDS=1.0
SIGNAL_MAX_AGE_SECONDS=120
# A leg smaller than the exchange's minimum order is skipped, never rounded up.
MIN_NOTIONAL_USD=0
# false = open nothing new; closes, stop-losses and take-profits still work.
TRADING_ENABLED=true
