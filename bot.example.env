# One MarketAI bot's settings, for setting it up by hand. The setup (./setup.sh, or
# setup.cmd on Windows) writes these files for you, and checks them first.
#
# Copy this file to bot-<id>.env, where <id> is the bot's id on My bots, for example
# bot-k7m3q9x2.env. It holds your token and keys: never share or commit it.
# A value with spaces, $ or # goes in single quotes, like  KEY='pa$s #1'.

# --- MarketAI: from the bot's card on My bots --------------------------------------
MARKETAI_HOST=https://app.marketai.trade
MARKETAI_BOT_TOKEN=
MARKETAI_BOT_UID=
# A name for its log.
NAME=MyBot

# --- the licence and risk disclaimer -------------------------------------------------
# The bot trades only once you accept LICENSE (version 1.1) and DISCLAIMER.md of
# 2026-09-25, both in this folder. Read them, then remove the # below to accept them.
# TERMS_VERSION_ACCEPTED=2026-09-25

# --- the exchange account this bot trades (one account per bot) --------------------
# Bitget: an API key with TRADE permission only, never withdrawal.
EXCHANGE=bitget
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
# A Bitget demo account (no real money):
# BITGET_DEMO=true

# Hyperliquid instead: set EXCHANGE=hyperliquid, delete the Bitget lines, and fill in
# an API wallet's key (it can trade but not withdraw) and the account it trades for:
# HYPERLIQUID_PRIVATE_KEY=
# HYPERLIQUID_ACCOUNT_ADDRESS=
# HYPERLIQUID_ENV=testnet      # only for Hyperliquid's testnet (no real money)

# --- optional ------------------------------------------------------------------------
# The bot uses the leverage set on My bots. A value here overrides it.
# OPEN_LEVERAGE=
# false = open nothing new; closes, stop-losses and take-profits still work.
# TRADING_ENABLED=false
